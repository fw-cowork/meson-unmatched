diff --git a/drivers/pci/Kconfig b/drivers/pci/Kconfig
index ea9868425d0..e3bff9dd856 100644
--- a/drivers/pci/Kconfig
+++ b/drivers/pci/Kconfig
@@ -11,6 +11,15 @@ menuconfig PCI
 
 if PCI
 
+config PCIE_ENUM_DEBUG
+	bool "PCIe enumeration step-by-step trace"
+	default y
+	help
+	  Add step-by-step printf() prints to the PCI enumeration
+	  code (pci-uclass.c, pci_auto.c): every BDF probed, BAR sizing
+	  and allocation, bridge configuration.  Works on any PCI
+	  platform.  Intended for learning the PCIe enumeration.
+
 config DM_PCI_COMPAT
 	bool "Enable compatible functions for PCI"
 	help
@@ -177,6 +186,16 @@ config PCIE_DW_SIFIVE
 	  Say Y here if you want to enable PCIe controller support on
 	  FU740.
 
+config PCIE_DW_SIFIVE_DEBUG
+	bool "SiFive FU740 PCIe bring-up trace"
+	depends on PCIE_DW_SIFIVE
+	default y
+	help
+	  Add step-by-step printf() to the FU740 PCIe driver, covering
+	  GPIO reset, PHY CR_PARA programming, LTSSM enable, link
+	  training poll, iATU window setup, and enumeration handoff.
+	  Intended for learning the PCIe RC initialisation sequence.
+
 config SYS_FSL_PCI_VER_3_X
 	bool
 
